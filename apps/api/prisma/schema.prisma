// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── User ────────────────────────────────────────────────────
model User {
  id           String       @id @default(cuid())
  cfHandle     String       @unique
  currentRating Int?
  maxRating    Int?
  rank         String?
  maxRank      String?
  avatar       String?
  country      String?
  organization String?
  contribution Int          @default(0)
  friendOfCount Int         @default(0)
  lastSynced   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  submissions  Submission[]
  notes        Note[]
}

// ─── Problem ─────────────────────────────────────────────────
model Problem {
  id          String  @id  // e.g. "1900A" (contestId + index)
  contestId   Int
  index       String  // "A", "B", "C1", etc.
  name        String
  rating      Int?
  tags        String[]  // PostgreSQL text array
  url         String
  problemType String    @default("PROGRAMMING")

  submissions Submission[]
  notes       Note[]
}

// ─── Submission ───────────────────────────────────────────────
model Submission {
  id              String   @id   // Codeforces submission ID (as string)
  userId          String
  problemId       String
  verdict         String   // OK, WRONG_ANSWER, TLE, etc.
  language        String
  passedTestCount Int      @default(0)
  timeConsumed    Int?     // milliseconds
  memoryConsumed  Int?     // kilobytes
  submittedAt     DateTime

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([problemId])
  @@index([userId, verdict])
  @@index([submittedAt])
}

// ─── Note ────────────────────────────────────────────────────
model Note {
  id        String   @id @default(cuid())
  userId    String
  problemId String
  content   String   @db.Text
  code      String?  @db.Text
  language  String?  // cpp | python | typescript
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([userId, problemId])
  @@index([userId])
}
