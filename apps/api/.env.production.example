# ─── Required in production ──────────────────────────────────────
# Set these in Railway dashboard under Variables

# PostgreSQL — Railway auto-injects this as $DATABASE_URL
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Redis — Get from Upstash dashboard: Settings > REST API > UPSTASH_REDIS_URL
REDIS_URL=rediss://default:YOUR_TOKEN@YOUR_ENDPOINT.upstash.io:6379

# Your Vercel frontend URL (set after deploying frontend)
WEB_URL=https://your-app.vercel.app

# Port — Railway sets this automatically
PORT=3001

NODE_ENV=production
